# =========================================================
# Biblioteca Virtual - variables de producción
# Copiá este archivo a `.env.prod` y rellená los valores reales.
# El archivo `.env.prod` está ignorado por git (no se sube).
#
# Para copiarlo:
#   cp env.prod.example .env.prod
# =========================================================

# --- Postgres ---
POSTGRES_DB=biblioteca_virtual
POSTGRES_USER=biblioteca_app
# Generá una password fuerte: openssl rand -base64 32
POSTGRES_PASSWORD=cambiar-por-password-fuerte

# --- JWT (autenticación) ---
# Mínimo 32 caracteres. Generala con: openssl rand -base64 48
JWT_KEY=cambiar-por-clave-secreta-de-al-menos-32-caracteres
JWT_ISSUER=BibliotecaVirtual
JWT_AUDIENCE=BibliotecaVirtualUsers

# --- URLs públicas (los subdominios que apuntan al túnel) ---
# Estos los configurás en Cloudflare al crear el túnel.
FRONTEND_URL=https://biblioteca.alvaroacevedo.dev
VITE_API_BASE_URL=https://api.biblioteca.alvaroacevedo.dev/api

# --- Cloudflare Tunnel ---
# Lo obtenés desde dash.cloudflare.com → Zero Trust → Networks → Tunnels → Create tunnel
# Es un token largo (no un UUID). Va sin comillas.
CLOUDFLARE_TUNNEL_TOKEN=cambiar-por-token-del-tunnel
